# =============================================================================
# PlanificaHIS — Variables de entorno
# Copie este archivo como .env (XAMPP) o configúrelas en Render > Environment.
# En producción APP_ENV=production / RENDER=1 exige secretos de 32+ caracteres.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_ENV=production
RENDER=0
APP_DEMO_MODE=0
# Clave inicial de las cuentas preactivadas (ADMIN_ESTADISTICA / JEFA_OBSTETRAS).
# Si se deja vacía, la clave inicial es el propio DNI de la usuaria.
APP_PREACTIVATED_PASSWORD=
# 1 = exige código TOTP (segundo factor) después de la contraseña.
# 0 = acceso directo con DNI y contraseña. Por defecto está desactivado.
APP_2FA_REQUIRED=0
ALLOWED_ORIGIN=https://planificahis.onrender.com
# Render inyecta PORT=10000 automáticamente. En Docker local: 8080.
PORT=8080

# --- Base de datos principal (TiDB Cloud Serverless) ------------------------
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=app
DB_USER=usuario_tidb
DB_PASS=contraseña_tidb
DB_SSL=1
# Ruta legible al certificado CA de TiDB Cloud (opcional).
DB_SSL_CA=
# 1 fuerza la verificación de esquema en cada arranque; 0 la ejecuta una sola
# vez por instancia (semáforo en /tmp). Mantenga 0 en producción.
DB_AUTO_MIGRATE=0

# --- Secretos clínicos (obligatorios en producción, mínimo 32 caracteres) ---
HUARAL_AES_SECRET=cambie_este_secreto_aes_de_32_caracteres_o_mas
HUARAL_SESSION_SECRET=cambie_este_secreto_de_sesion_de_32_caracteres
# Compatibilidad con instalaciones antiguas; no usar en producción nueva.
ENCRYPTION_SECRET=

# --- Sincronización Nube <-> Local (CLI en la PC de Estadística) ------------
# Token obligatorio para ejecución web de sync_cloud_to_local.php.
# Direcciones: cloud-to-local | local-to-cloud | bidirectional.
# La sincronización local-to-cloud solo sube tablas originales del HIS y nunca
# crea tablas en el servidor del hospital.
SYNC_TOKEN=token_largo_y_aleatorio_para_sync
# Nube (si se omite, hereda DB_*).
CLOUD_DB_HOST=
CLOUD_DB_PORT=4000
CLOUD_DB_NAME=
CLOUD_DB_USER=
CLOUD_DB_PASS=
CLOUD_DB_SSL=1
CLOUD_DB_SSL_CA=
# Base local MariaDB 10.4.32 del hospital.
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=app
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# --- Administración (opcional) ----------------------------------------------
# DNI habilitado para generar exportaciones Nube -> Local desde la web.
APP_ADMIN_DNI=
# 1 = habilita la exportación web a cualquier sesión 2FA (solo si la instalación
# tiene un único administrador). Mantenga 0 y use APP_ADMIN_DNI en producción.
APP_ADMIN_NIVELID=0
