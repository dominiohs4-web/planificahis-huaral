# PlanificaHIS — Apache 2.4 (XAMPP / Render)
# Configuración mínima y compatible. No se usan directivas exclusivas de
# servidor (ServerTokens/ServerSignature) ni módulos sin proteger.

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Nunca exponer secretos, núcleo interno, dumps ni respaldos.
<FilesMatch "^(\.env|db\.php|catalogo_establecimientos\.php|sync_cloud_to_local\.php|.*\.(sql|bat|sh|md|ini|log|bak|zip))$">
    Require all denied
</FilesMatch>

# Metadatos de despliegue y control de versiones.
<FilesMatch "^(\.htaccess|\.htpasswd|\.dockerignore|Dockerfile|render\.ya?ml|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Tipos MIME para la PWA (solo si el módulo está cargado).
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType font/woff2 .woff2
</IfModule>

# El service worker y el manifest nunca se cachean durante despliegues.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Service-Worker-Allowed "/"
    </IfModule>
</Files>

<Files "manifest.webmanifest">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </IfModule>
</Files>

# Apache en CGI/FastCGI no siempre expone Authorization a PHP.
# Las carpetas internas de desarrollo nunca se sirven por HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(?:node_modules|src|\.git|\.aistudio|scripts_hospital|docker|storage|private)(?:/|$) - [R=404,L]
</IfModule>
