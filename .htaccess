# PlanificaHIS — Apache (XAMPP / Render)
# Sirve index.php como única entrada de la aplicación PHP.
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Tipos MIME necesarios para PWA (Android/iPhone).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# El service worker debe actualizarse de inmediato y controlar todo el ámbito.
<Files "sw.js">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Service-Worker-Allowed "/"
  </IfModule>
</Files>

# El manifest no debe quedar cacheado durante despliegues.
<Files "manifest.webmanifest">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </IfModule>
</Files>

# Nunca exponer secretos, respaldos, dumps ni metadatos del repositorio.
<FilesMatch "(?i)^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|vite\.config\.ts|metadata\.json|Dockerfile|render\.ya?ml|README\.md|\.dockerignore|.*\.(dump|bak|old|log|ini|sh))$">
  Require all denied
</FilesMatch>
# Cualquier dump SQL queda fuera del alcance web, salvo el script de índices
# que la propia aplicación ofrece como descarga.
<FilesMatch "(?i)^(?!optimizar_indices_5gb\.sql$).*\.sql$">
  Require all denied
</FilesMatch>

# Carpetas de desarrollo que no deben servirse por HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apache no siempre expone Authorization a PHP (CGI/FastCGI). Lo copiamos a
  # una variable de entorno que PHP sí puede leer.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^(?:node_modules|src|\.git|\.aistudio)(?:/|$) - [R=404,L]
</IfModule>

# Los assets estáticos pueden cachearse; el HTML y PHP clínico no.
<FilesMatch "\.(png|svg|woff2?)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
